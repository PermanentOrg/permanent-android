<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="88dp"
    android:paddingEnd="88dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:fontFamily="@font/usual_regular"
        android:gravity="center"
        android:lineSpacingExtra="2sp"
        android:text="@string/list_load_more_error"
        android:textColor="@color/error500"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/btnRetry"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/list_load_more_retry"
        android:src="@drawable/ic_arrow_rotate_left_primary" />
</LinearLayout>
