<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="org.permanent.permanent.viewmodels.FileInfoViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black">

            <LinearLayout
                android:id="@+id/llRows"
                android:layout_width="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <include
                    android:id="@+id/nameRow"
                    layout="@layout/item_info_text_row"
                    app:editable="@{safeUnbox(viewModel.isEditable)}"
                    app:label="@{@string/file_info_name}"
                    app:placeholder="@{``}"
                    app:value="@{viewModel.name}" />

                <include
                    android:id="@+id/descriptionRow"
                    layout="@layout/item_info_text_row"
                    app:editable="@{safeUnbox(viewModel.isEditable)}"
                    app:label="@{@string/file_info_description}"
                    app:placeholder="@{@string/file_info_add_description}"
                    app:value="@{viewModel.description}" />

                <include
                    android:id="@+id/dateRow"
                    layout="@layout/item_info_tap_row"
                    app:editable="@{safeUnbox(viewModel.isEditable)}"
                    app:label="@{@string/file_info_date}"
                    app:placeholder="@{@string/file_info_add_date_time}"
                    app:value="@{viewModel.date}" />

                <include
                    android:id="@+id/locationRow"
                    layout="@layout/item_info_tap_row"
                    app:editable="@{safeUnbox(viewModel.isEditable)}"
                    app:label="@{@string/file_info_location}"
                    app:placeholder="@{@string/file_info_add_location}"
                    app:value="@{viewModel.address}" />

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:visibility="@{safeUnbox(viewModel.hasCoordinates) ? View.VISIBLE : View.GONE}" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@{safeUnbox(viewModel.isEditable) ? @dimen/info_row_gap_boxed : @dimen/info_row_gap_plain}"
                    android:visibility="@{safeUnbox(viewModel.isEditable) || safeUnbox(viewModel.existsTags) ? View.VISIBLE : View.GONE}">

                    <TextView
                        android:id="@+id/tvTags"
                        style="@style/InfoRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@{safeUnbox(viewModel.isEditable) ? @dimen/info_row_box_padding : 0f}"
                        android:paddingEnd="@{safeUnbox(viewModel.isEditable) ? @dimen/info_row_box_padding : 0f}"
                        android:text="@string/file_info_tags" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFileTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:onClick="@{() -> viewModel.onEditTagsClick()}"
                        android:visibility="@{safeUnbox(viewModel.existsTags) ? View.VISIBLE : View.GONE}"
                        app:chipSpacingVertical="8dp" />

                    <TextView
                        android:id="@+id/tvAddTags"
                        style="@style/InfoRowValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_info_row_box"
                        android:drawablePadding="12dp"
                        android:hint="@string/file_info_tap_to_add"
                        android:onClick="@{() -> viewModel.onEditTagsClick()}"
                        android:padding="@dimen/info_row_box_padding"
                        android:visibility="@{safeUnbox(viewModel.isEditable) &amp;&amp; !safeUnbox(viewModel.existsTags) ? View.VISIBLE : View.GONE}"
                        app:drawableEndCompat="@drawable/ic_info_plus_white" />
                </LinearLayout>
            </LinearLayout>

            <androidx.core.widget.ContentLoadingProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="@{safeUnbox(viewModel.isBusy) ? View.VISIBLE : View.GONE}" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
