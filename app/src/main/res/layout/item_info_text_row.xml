<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />

        <variable
            name="label"
            type="String" />

        <variable
            name="value"
            type="String" />

        <variable
            name="placeholder"
            type="String" />

        <variable
            name="editable"
            type="boolean" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@{editable ? @dimen/info_row_gap_boxed : @dimen/info_row_gap_plain}"
        android:visibility="@{editable || !TextUtils.isEmpty(value) ? View.VISIBLE : View.GONE}">

        <TextView
            android:id="@+id/tvLabel"
            style="@style/InfoRowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@{editable ? @dimen/info_row_box_padding : 0f}"
            android:paddingEnd="@{editable ? @dimen/info_row_box_padding : 0f}"
            android:text="@{label}" />

        <LinearLayout
            android:id="@+id/llBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@{editable ? @drawable/bg_info_row_box : null}"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@{editable ? @dimen/info_row_box_padding : 0f}">

            <EditText
                android:id="@+id/etValue"
                style="@style/InfoRowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:focusable="@{editable}"
                android:focusableInTouchMode="@{editable}"
                android:hint="@{placeholder}"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:padding="0dp"
                android:text="@{value}" />

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@null"
                android:src="@{TextUtils.isEmpty(value) ? @drawable/ic_info_plus_white : @drawable/ic_info_edit_white}"
                android:visibility="@{editable ? View.VISIBLE : View.GONE}" />
        </LinearLayout>
    </LinearLayout>
</layout>
